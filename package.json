{
  "name": "ai-trade",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI Trading Intelligence Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --conditions=react-server --no-deprecation scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --no-deprecation scripts/seed.ts",
    "providers:verify": "tsx --conditions=react-server --no-deprecation scripts/verify-providers.ts",
    "worker": "tsx --conditions=react-server --no-deprecation scripts/worker.ts",
    "refresh": "tsx --conditions=react-server --no-deprecation scripts/refresh-once.ts",
    "evaluate": "tsx --conditions=react-server --no-deprecation scripts/evaluate.ts",
    "backtest": "tsx --conditions=react-server --no-deprecation scripts/backtest.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "lightweight-charts": "4.2.3",
    "next": "^16.4.3",
    "postgres": "3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.30.1",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  }
}
