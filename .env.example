# =============================================================================
# AI Trade - environment configuration (PLACEHOLDERS ONLY - never commit real secrets)
# Copy to .env.local for local development:  cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# "local"  -> SQLite file database (default, zero install)
# "postgres" -> set DATABASE_URL to a PostgreSQL connection string
DATABASE_URL=
# Path to the SQLite file used when DATABASE_URL is empty.
SQLITE_PATH=./data/ai-trade.db

# Data mode:
#   real    - only real provider data is used (default)
#   offline - no network calls; serves ONLY previously cached rows from the DB.
#             Offline mode NEVER synthesises prices; empty results stay empty.
DATA_MODE=real

# ---------------------------------------------------------------------------
# Authentication (required before deploying publicly)
# A single-user password gate. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If AUTH_PASSWORD is empty the app only accepts connections from localhost.
# ---------------------------------------------------------------------------
AUTH_PASSWORD=
# Secret used to sign the session cookie. REQUIRED when AUTH_PASSWORD is set.
AUTH_SESSION_SECRET=
# Session lifetime in hours.
AUTH_SESSION_HOURS=72

# Shared secret required by POST /api/cron/* so schedulers can trigger refreshes.
# Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---------------------------------------------------------------------------
# Market data: Indodax public API (no key, nothing to configure)
# The app is scoped to Indodax spot IDR pairs. Capital, risk per trade, cost
# assumptions and which pairs to scan are set in the app: Settings -> Capital & risk.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# News providers
# ---------------------------------------------------------------------------
# Comma-separated feed ids from src/lib/providers/news/feeds.ts, or "all".
NEWS_FEEDS=fed_monetary,coindesk
# Optional extra RSS/Atom feeds: id|name|url, separated by ";"
NEWS_EXTRA_FEEDS=

# ---------------------------------------------------------------------------
# AI analysis (OPTIONAL - the platform works without it)
# When unset, the app falls back to deterministic technical analysis and
# labels AI commentary as unavailable.
# ---------------------------------------------------------------------------
# A fallback chain, tried left to right: the next provider is used only when
# the previous one fails (quota exhausted, outage, invalid answer).
# Providers: anthropic | openai | openrouter | gemini | groq | ollama, or "none".
# Free setup: AI_PROVIDER=gemini,groq  (append ,ollama once Ollama is installed)
# Each *_MODEL may list several models, tried in order: free tiers overload
# and run out per model, so a second model often still answers.
AI_PROVIDER=none

# Google Gemini - free tier, no card. Key: https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products; this app
# sends only public market data (prices, indicators, news), never your money.
# 3.8 Flash is the strongest free model for this work but was often
# overloaded (HTTP 503) on 2026-10-28; 3.5 Flash kept answering.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# Groq - free tier, no card. Key: https://console.groq.com/keys
# Free plan: ~1,000 output tokens per minute for this model, i.e. roughly one
# analysis a minute; a faster second request is refused until the minute passes.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama - free, local, unlimited. Install from https://ollama.com, then
# `ollama pull qwen3.8:27b` (~18 GB; needs 32 GB RAM).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# Paid providers - kept for later, NOT used unless added to AI_PROVIDER above.
# OpenAI and OpenRouter have no default model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Minimum minutes between AI analyses of the same asset+timeframe (cost control).
AI_CACHE_MINUTES=180
# Hard daily ceiling on AI calls. 0 disables AI entirely.
AI_MAX_CALLS_PER_DAY=50

# ---------------------------------------------------------------------------
# Worker (`npm run worker`, or `npm run dev:all` for app + worker) - optional
# ---------------------------------------------------------------------------
# The scan runs hourly, this many seconds after each Indodax candle close; the
# live monitor checks prices every minute in between.
# WORKER_SCAN_OFFSET_SECONDS=90
# How many of the best setups get AI commentary after each scan.
# WORKER_AI_SETUPS=2
# WORKER_NEWS_MINUTES=30
# WORKER_EVALUATE_MINUTES=60
# WORKER_VALIDATE_HOURS=24

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
