# =============================================================================
# AI Trade - environment configuration (PLACEHOLDERS ONLY - never commit real secrets)
# Copy to .env.local for local development:  cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# "local"  -> SQLite file database (default, zero install)
# "postgres" -> set DATABASE_URL to a PostgreSQL connection string
DATABASE_URL=
# Path to the SQLite file used when DATABASE_URL is empty.
SQLITE_PATH=./data/ai-trade.db

# Data mode:
#   real    - only real provider data is used (default)
#   offline - no network calls; serves ONLY previously cached rows from the DB.
#             Offline mode NEVER synthesises prices; empty results stay empty.
DATA_MODE=real

# ---------------------------------------------------------------------------
# Authentication (required before deploying publicly)
# A single-user password gate. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If AUTH_PASSWORD is empty the app only accepts connections from localhost.
# ---------------------------------------------------------------------------
AUTH_PASSWORD=
# Secret used to sign the session cookie. REQUIRED when AUTH_PASSWORD is set.
AUTH_SESSION_SECRET=
# Session lifetime in hours.
AUTH_SESSION_HOURS=72

# Shared secret required by POST /api/cron/* so schedulers can trigger refreshes.
# Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---------------------------------------------------------------------------
# Crypto market data (no API key required)
# ---------------------------------------------------------------------------
# binance | coinbase
CRYPTO_PROVIDER=binance
# Override the Binance REST base if api.binance.com is blocked in your region
# (e.g. https://api.binance.us for US users - note: different symbol coverage).
BINANCE_BASE_URL=https://api.binance.com
COINBASE_BASE_URL=https://api.coinbase.com

# ---------------------------------------------------------------------------
# Stock market data
# ---------------------------------------------------------------------------
# Comma-separated priority list. First provider that supports the requested
# market AND timeframe wins. Options: nasdaq, alphavantage, twelvedata, yahoo
# A provider without its API key is skipped automatically, so leaving
# twelvedata in the list costs nothing until you set TWELVEDATA_API_KEY.
STOCK_PROVIDERS=nasdaq,alphavantage,twelvedata

# Alpha Vantage - free key: https://www.alphavantage.co/support/#api-key
# Free tier at time of writing: 25 requests/day. US markets. Daily + intraday.
ALPHAVANTAGE_API_KEY=

# Twelve Data - free key: https://twelvedata.com/apikey
# Free tier at time of writing: 800 requests/day, 8 requests/minute.
#
# THIS IS THE SUPPORTED PATH TO INDONESIAN (IDX) STOCK DATA.
# Their reference data confirms IDX symbols (BBCA -> exchange IDX, MIC XIDX,
# currency IDR). Whether the FREE plan returns IDX *candles* is unverified, so
# after setting the key run:   npm run providers:verify
# That makes one real request for BBCA on IDX and prints exactly what came back.
TWELVEDATA_API_KEY=

# Yahoo Finance (unofficial, undocumented endpoint, no key).
# Only free source observed to return IDX (.JK) candles, but it is rate-limited
# aggressively per IP and is NOT an officially supported API. Opt in explicitly.
ENABLE_YAHOO_PROVIDER=false

# ---------------------------------------------------------------------------
# News providers
# ---------------------------------------------------------------------------
# Comma-separated feed ids from src/lib/providers/news/feeds.ts, or "all".
NEWS_FEEDS=fed_monetary,sec_8k,coindesk
# SEC requires a declaring User-Agent with contact info for EDGAR requests.
# Format: "AppName/version (contact: you@example.com)"
SEC_USER_AGENT=
# Optional extra RSS/Atom feeds: id|name|url, separated by ";"
NEWS_EXTRA_FEEDS=

# ---------------------------------------------------------------------------
# AI analysis (OPTIONAL - the platform works without it)
# When unset, the app falls back to deterministic technical analysis and
# labels AI commentary as unavailable.
# ---------------------------------------------------------------------------
# none | anthropic | openai | openrouter | ollama
AI_PROVIDER=none
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Minimum minutes between AI analyses of the same asset+timeframe (cost control).
AI_CACHE_MINUTES=180
# Hard daily ceiling on AI calls. 0 disables AI entirely.
AI_MAX_CALLS_PER_DAY=50

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Risk defaults (configurable examples, NOT financial advice)
# ---------------------------------------------------------------------------
RISK_ACCOUNT_EQUITY=10000
RISK_PERCENT_PER_TRADE=1
RISK_MAX_OPEN_RISK_PERCENT=5
